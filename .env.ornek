# Bu dosyayı ".env" adıyla kopyalayıp doldurun. .env dosyası git'e GİRMEZ.

# Yönetim paneli parolası. ZORUNLU — tanımsızsa canlıda sunucu açılmaz.
# Uzun ve tahmin edilemez olsun (örn. şu komutla üretin: openssl rand -base64 24)
ADMIN_PASSWORD=

# Oturum çerezinin imza anahtarı. Sabit tutun, yoksa sunucu her yeniden
# başladığında panel oturumunuz düşer. (openssl rand -hex 32)
SESSION_SECRET=

# Canlı alan adı. Sitemap, canonical adresler ve paylaşım kartları bunu kullanır.
SITE_URL=https://odtuvt.org.tr
