<%- include('partials/head') %>
<%- include('partials/nav') %>

<!-- Hero: koyu tam genişlik karo -->
<section class="tile tile-dark hero">
  <div class="hero-inner reveal">
    <p class="eyebrow"><%= site.slogan %></p>
    <h1>ODTÜ Verimlilik<br>Topluluğu</h1>
    <p class="lede"><%= site.heroLede %></p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/katil">Aramıza katıl</a>
      <a class="link-more" href="/projeler">Projeleri keşfet <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></a>
    </div>
  </div>
</section>

<!-- Öne çıkan: YMG, tam genişlik açık karo -->
<% const ymg = featured[0]; %>
<section class="tile tile-gray feature-tile">
  <div class="feature-inner reveal">
    <p class="eyebrow eyebrow-red"><%= ymg.short %></p>
    <h2 class="display"><%= ymg.tagline %></h2>
    <p class="lede lede-dark"><%= ymg.summary %></p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/projeler/<%= ymg.slug %>">YMG'yi incele</a>
      <a class="link-more" href="/projeler">Tüm projeler <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></a>
    </div>
    <img class="feature-img" src="<%= ymg.hero %>" alt="Yönetim ve Mühendislik Günleri etkinliğinden bir kare" loading="lazy">
  </div>
</section>

<!-- 2'li karo: VakaVT + Generation -->
<section class="tile-duo">
  <% featured.slice(1, 3).forEach(function (p) { %>
  <article class="tile tile-white duo-cell reveal">
    <p class="eyebrow eyebrow-red"><%= p.short %></p>
    <h3><%= p.tagline %></h3>
    <p class="duo-summary"><%= p.summary %></p>
    <a class="link-more" href="/projeler/<%= p.slug %>">Daha fazla bilgi <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></a>
    <img class="duo-img" src="<%= p.hero %>" alt="<%= p.name %> etkinliğinden bir kare" loading="lazy">
  </article>
  <% }) %>
</section>

<!-- Rakamlar: kırık simetri — değerler sitenin kendi sayaçlarından -->
<section class="tile tile-white stats">
  <div class="container stats-grid">
    <div class="stats-head reveal">
      <h2>Rakamlarla<br>bir öğrenci topluluğu.</h2>
      <p>Öğrenciler, akademisyenler ve iş dünyası arasında 1992'den beri işleyen bir köprü.</p>
    </div>
    <dl class="stats-list reveal">
      <% site.stats.forEach(function (s) { %>
      <div class="stat">
        <dt><%= s.label %></dt>
        <dd><%= s.value %></dd>
      </div>
      <% }) %>
    </dl>
  </div>
</section>

<!-- Diğer projeler -->
<section class="tile tile-gray others">
  <div class="container">
    <div class="section-head reveal">
      <h2>Sekiz proje. Tek amaç.</h2>
      <a class="link-more" href="/projeler">Tümünü gör <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></a>
    </div>
    <div class="card-row">
      <% rest.forEach(function (p) { %>
      <a class="card reveal" href="/projeler/<%= p.slug %>">
        <span class="card-icon"><%- include('partials/icon', { name: p.icon }) %></span>
        <h3><%= p.short %></h3>
        <p><%= p.tagline %></p>
        <span class="card-more">İncele <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- Hakkımızda önizleme: kırık simetri, görselli -->
<section class="tile tile-white editorial">
  <div class="container editorial-grid">
    <div class="editorial-aside reveal">
      <h2>Biz kimiz?</h2>
      <img class="aside-img" src="<%= site.aboutImage %>" alt="ODTÜ Verimlilik Topluluğu üyeleri bir arada" loading="lazy">
    </div>
    <div class="editorial-body reveal">
      <p class="lede-dark"><%= site.about[0] %></p>
      <p><%= site.about[1] %></p>
      <div class="cta-row">
        <a class="link-more" href="/hakkimizda">Hakkımızda <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></a>
      </div>
    </div>
  </div>
</section>

<!-- Partner şirketler -->
<section class="tile tile-gray partners">
  <div class="container">
    <div class="section-head reveal">
      <h2>Partner şirketlerimiz</h2>
      <p class="section-sub">90'dan fazla şirket iş birliğinden bazıları.</p>
    </div>
    <div class="partner-grid reveal">
      <% partners.forEach(function (pt) { %>
      <div class="partner-cell" title="<%= pt.name %>">
        <img src="<%= pt.logo %>" alt="<%= pt.name %> logosu" loading="lazy">
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Katıl CTA -->
<section class="tile tile-dark join-cta">
  <div class="hero-inner reveal">
    <h2 class="display-light">Sıradaki projeyi<br>birlikte kuralım.</h2>
    <p class="lede">Bölümün fark etmez. Merakın yeter.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/katil">Başvuru formu</a>
      <a class="link-more" href="/hakkimizda">Önce topluluğu tanı <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
