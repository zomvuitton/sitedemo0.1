<%- include('partials/head') %>
<%- include('partials/nav') %>

<!-- Hero: koyu tam genişlik karo + imleci takip eden partikül animasyonu -->
<section class="tile tile-dark hero">
  <div class="hero-particles" id="heroParticles" aria-hidden="true"></div>
  <div class="hero-inner reveal">
    <p class="eyebrow"><%= site.slogan %></p>
    <h1><%- br(texts.homeHeroTitle) %></h1>
    <p class="lede" id="heroLede"><%= site.heroLede %></p>
    <div class="cta-row">
      <a class="btn btn-glass" href="/projeler"><%= texts.homeHeroButton %></a>
      <a class="link-more" href="/hakkimizda"><%= texts.homeHeroLink %> <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></a>
    </div>
  </div>
</section>

<!-- Yaklaşan etkinlikler: panelden yönetilir, tarihi geçince otomatik düşer -->
<% if (upcoming.length) { %>
<section class="tile tile-white events">
  <div class="container">
    <div class="section-head reveal">
      <h2><%= texts.homeEventsTitle %></h2>
    </div>
    <div class="card-row card-row-2">
      <% upcoming.forEach(function (e) { %>
      <<%= e.link ? 'a href="' + e.link + '" target="_blank" rel="noopener"' : 'div' %> class="card event-card reveal">
        <span class="event-date" aria-hidden="true">
          <strong><%= e.day %></strong>
          <span><%= e.month %></span>
        </span>
        <span class="event-info">
          <h3><%= e.title %></h3>
          <p><%= [e.time, e.place].filter(Boolean).join(" · ") %></p>
          <% if (e.link) { %><span class="card-more">Detay <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></span><% } %>
        </span>
      </<%= e.link ? 'a' : 'div' %>>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- Projeler: 3+3 alfabetik ızgara -->
<section class="tile tile-gray others">
  <div class="container">
    <div class="section-head reveal">
      <h2><%= texts.homeProjectsTitle %></h2>
      <a class="link-more" href="/projeler">Tümünü gör <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></a>
    </div>
    <div class="card-row card-row-3">
      <% homeProjects.forEach(function (p) { %>
      <a class="card card-project reveal" href="/projeler/<%= p.slug %>">
        <% if (p.hero) { %>
        <img class="card-img" src="<%= p.hero %>" alt="<%= p.name %> etkinliğinden bir kare" loading="lazy">
        <% } else { %>
        <span class="card-icon"><%- include('partials/icon', { name: p.icon }) %></span>
        <% } %>
        <h3><%= p.name %></h3>
        <p><%= p.tagline %></p>
        <span class="card-more">İncele <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- Rakamlar: kırık simetri — değerler sitenin kendi sayaçlarından -->
<section class="tile tile-white stats">
  <div class="container stats-grid">
    <div class="stats-head reveal">
      <h2><%- br(texts.homeStatsTitle) %></h2>
      <p><%= texts.homeStatsLede %></p>
    </div>
    <dl class="stats-list reveal">
      <% site.stats.forEach(function (s) { %>
      <div class="stat">
        <dt><%= s.label %></dt>
        <dd><%= s.value %></dd>
      </div>
      <% }) %>
    </dl>
  </div>
</section>

<!-- Hakkımızda önizleme: kırık simetri, görselli -->
<section class="tile tile-white editorial">
  <div class="container editorial-grid">
    <div class="editorial-aside reveal">
      <h2><%= texts.homeAboutTitle %></h2>
      <img class="aside-img" src="<%= site.aboutImage %>" alt="ODTÜ Verimlilik Topluluğu üyeleri bir arada" loading="lazy">
    </div>
    <div class="editorial-body reveal">
      <p class="lede-dark"><%= site.about[0] %></p>
      <p><%= site.about[1] %></p>
      <div class="cta-row">
        <a class="link-more" href="/hakkimizda">Hakkımızda <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></a>
      </div>
    </div>
  </div>
</section>

<!-- Partner şirketler -->
<section class="tile tile-gray partners">
  <div class="container">
    <div class="section-head reveal">
      <h2><%= texts.homePartnersTitle %></h2>
      <p class="section-sub"><%= texts.homePartnersSub %></p>
    </div>
    <div class="partner-grid reveal">
      <% partners.forEach(function (pt) { %>
      <div class="partner-cell" title="<%= pt.name %>">
        <img src="<%= pt.logo %>" alt="<%= pt.name %> logosu" loading="lazy">
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Kampüste buluşalım — morph partikül animasyonlu geniş karo -->
<section class="tile tile-dark join-cta campus" id="campusSection">
  <div class="hero-particles" id="campusParticles" aria-hidden="true"></div>
  <div class="container campus-grid">
    <div class="campus-text reveal">
      <h2 class="display-light"><%- br(texts.campusTitle) %></h2>
      <p class="lede"><%= texts.campusLede %></p>
      <div class="cta-row">
        <a class="btn btn-glass" href="/iletisim"><%= texts.campusButton %></a>
        <a class="link-more" href="<%= site.social.instagram %>" target="_blank" rel="noopener"><%= texts.campusLink %> <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></a>
      </div>
    </div>
    <div class="campus-morph-zone" id="campusMorphZone" aria-hidden="true"></div>
  </div>
</section>

<script>
  // Animasyon modülleri (Three.js dahil ~700KB) sayfa çizildikten sonra
  // boşta yüklenir — ilk açılışı bloklamaz
  window.addEventListener("load", function () {
    var go = function () { import("/js/hero-particles.js"); import("/js/campus-morph.js"); };
    if ("requestIdleCallback" in window) requestIdleCallback(go, { timeout: 2500 });
    else setTimeout(go, 400);
  });
</script>
<%- include('partials/footer') %>
