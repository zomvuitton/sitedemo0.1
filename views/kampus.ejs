<%- include('partials/head') %>
<%- include('partials/nav') %>

<!-- Hero'nun arka planı stilize kampüs haritasıdır; imleç EM binasına
     yaklaştıkça hale parlar ve etiket belirir (main.js, --em-glow) -->
<section class="tile tile-white page-hero campus-map-hero" id="campusMapHero" style="--em-glow:0">
  <div class="campus-map-bg" aria-hidden="true">
    <%- include('partials/campus-map') %>
  </div>
  <div class="container">
    <div class="page-hero-inner reveal">
      <p class="eyebrow eyebrow-red">Kampüs</p>
      <h1><%- br(texts.kampusTitle) %></h1>
      <p class="lede lede-dark"><%= texts.kampusLede %></p>
    </div>
  </div>
</section>

<!-- Yazı akışı: panelden yönetilir, taslaklar burada görünmez -->
<section class="tile tile-white">
  <div class="container">
    <div class="section-head reveal">
      <h2><%= texts.kampusPostsTitle %></h2>
    </div>
    <% if (posts.length) { %>
    <div class="card-row card-row-2">
      <% posts.forEach(function (p) { %>
      <a class="card card-post reveal" href="/kampus/<%= p.slug %>">
        <% if (p.cover) { %>
        <img class="card-img" src="<%= p.cover %>" alt="<%= p.title %> yazısının kapak görseli" loading="lazy">
        <% } %>
        <span class="post-meta"><%= trTarih(p.date) %><%= p.tag ? " · " + p.tag : "" %></span>
        <h3><%= p.title %></h3>
        <p><%= p.excerpt %></p>
        <span class="card-more">Okumaya devam <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></span>
      </a>
      <% }) %>
    </div>
    <% } else { %>
    <p class="posts-empty reveal">Henüz yazı yayımlanmadı. Yakında burada olacak.</p>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
