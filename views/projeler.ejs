<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="tile tile-white page-hero wave-hero">
  <!-- Girişin ortasından geçen dalga çizgileri: açılışta hızlı, sonra sakinleşir -->
  <canvas class="wave-band" aria-hidden="true"></canvas>
  <div class="container">
    <div class="page-hero-inner reveal">
      <p class="eyebrow eyebrow-red">Projeler</p>
      <h1><%- br(texts.projectsTitle) %></h1>
      <p class="lede lede-dark"><%= texts.projectsLede %></p>
    </div>
  </div>
</section>

<!-- Proje dizini: kart yok, ince çizgilerle ayrılmış tam genişlik satırlar.
     İmleç satıra gelince projenin görseli arkada belirir, yazı beyaza döner. -->
<section class="tile tile-white project-index">
  <% projects.forEach(function (p, i) { %>
  <a class="project-strip reveal" href="/projeler/<%= p.slug %>" style="--strip-img:url('<%= p.hero %>')">
    <span class="project-strip-bg" aria-hidden="true"></span>
    <span class="container project-strip-inner">
      <span class="project-strip-no">0<%= i + 1 %></span>
      <span class="project-strip-text">
        <h2><%= p.name %></h2>
        <p><%= p.summary %></p>
      </span>
      <span class="project-strip-go"><%- include('partials/icon', { name: 'arrow' }) %></span>
    </span>
  </a>
  <% }) %>
</section>

<%- include('partials/footer') %>
