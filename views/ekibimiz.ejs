<%- include('partials/head') %>
<%- include('partials/nav') %>

<!-- Partikül morph: dağınık partiküller dönerek VT logosuna toplanır -->
<section class="tile tile-white page-hero team-hero" id="teamSection">
  <div class="hero-particles" id="teamParticles" aria-hidden="true"></div>
  <div class="container team-hero-grid">
    <div class="page-hero-inner reveal">
      <p class="eyebrow eyebrow-red">Ekibimiz</p>
      <h1><%- br(texts.teamTitle) %></h1>
      <p class="lede lede-dark"><%= texts.teamLede %></p>
    </div>
    <div class="campus-morph-zone" id="teamMorphZone" aria-hidden="true"></div>
  </div>
</section>

<script>
  // Morph modülü (Three.js dahil) sayfa çizildikten sonra boşta yüklenir
  window.addEventListener("load", function () {
    var go = function () { import("/js/campus-morph.js"); };
    if ("requestIdleCallback" in window) requestIdleCallback(go, { timeout: 2500 });
    else setTimeout(go, 400);
  });
</script>

<% boards.filter(b => b.members.length).forEach(function (b, i) { %>
<section class="tile <%= i % 2 === 0 ? 'tile-gray' : 'tile-white' %>">
  <div class="container">
    <div class="section-head reveal">
      <h2><%= b.name %></h2>
    </div>
    <div class="people-grid">
      <% b.members.forEach(function (m) { %>
      <%- include('partials/person', { m: m }) %>
      <% }) %>
    </div>
  </div>
</section>
<% }) %>

<%
// İdari Kurul: proje liderleri + komite koordinatörlerinden otomatik türetilir.
// YK üyeleri (kurullar bölümünde zaten görünüyor) hariç tutulur; her grup kendi
// içinde isimlere göre tekilleştirilir.
const ykRe = /Yönetim Kurulu Üyesi|YK Üyesi/;
const leads = [];
const leadSeen = new Set();
projects.forEach(function (p) {
  (p.team || []).forEach(function (m) {
    if (ykRe.test(m.role) || m.onlyProject || leadSeen.has(m.name)) return;
    leadSeen.add(m.name);
    leads.push(m);
  });
});
const coords = [];
const coordSeen = new Set();
committees.forEach(function (c) {
  (c.team || []).forEach(function (m) {
    if (ykRe.test(m.role) || m.onlyProject || coordSeen.has(m.name)) return;
    coordSeen.add(m.name);
    coords.push(m);
  });
});
%>
<% if (leads.length || coords.length) { %>
<section class="tile tile-gray">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <h2>İdari Kurulumuz</h2>
        <p class="section-sub"><%= texts.teamIdariSub %></p>
      </div>
      <a class="link-more" href="/komiteler">Komiteleri incele <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></a>
    </div>

    <% if (leads.length) { %>
    <h3 class="people-subhead reveal">Proje Liderleri</h3>
    <div class="people-grid">
      <% leads.forEach(function (m) { %>
      <%- include('partials/person', { m: m }) %>
      <% }) %>
    </div>
    <% } %>

    <% if (coords.length) { %>
    <h3 class="people-subhead reveal">Komite Koordinatörleri</h3>
    <div class="people-grid">
      <% coords.forEach(function (m) { %>
      <%- include('partials/person', { m: m }) %>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>
<% } %>

<section class="tile tile-dark join-cta">
  <div class="hero-inner reveal">
    <h2 class="display-light"><%- br(texts.teamCtaTitle) %></h2>
    <p class="lede"><%= texts.teamCtaLede %></p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/iletisim"><%= texts.campusButton %></a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
