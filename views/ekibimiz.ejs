<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="tile tile-white page-hero">
  <div class="container">
    <div class="page-hero-inner reveal">
      <p class="eyebrow eyebrow-red">Ekibimiz</p>
      <h1>Topluluğu yürüten insanlar.</h1>
      <p class="lede lede-dark">Yönetim Kurulu, Denetleme ve Danışma Kurulu, proje liderleri ve komite koordinatörleri; altı projeyi ve 80'den fazla etkinliği her yıl yeniden kurar.</p>
    </div>
  </div>
</section>

<% boards.filter(b => b.members.length).forEach(function (b, i) { %>
<section class="tile <%= i % 2 === 0 ? 'tile-gray' : 'tile-white' %>">
  <div class="container">
    <div class="section-head reveal">
      <h2><%= b.name %></h2>
    </div>
    <div class="people-grid">
      <% b.members.forEach(function (m) { %>
      <div class="person reveal">
        <img class="person-photo" src="<%= m.photo %>" alt="<%= m.name %>" loading="lazy">
        <h3><%= m.name %></h3>
        <p><%= m.role %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% }) %>

<%
// İdari Kurul: proje liderleri + komite koordinatörlerinden otomatik türetilir.
// YK üyeleri (kurullar bölümünde zaten görünüyor) hariç tutulur; her grup kendi
// içinde isimlere göre tekilleştirilir.
const ykRe = /Yönetim Kurulu Üyesi|YK Üyesi/;
const leads = [];
const leadSeen = new Set();
projects.forEach(function (p) {
  (p.team || []).forEach(function (m) {
    if (ykRe.test(m.role) || leadSeen.has(m.name)) return;
    leadSeen.add(m.name);
    leads.push(m);
  });
});
const coords = [];
const coordSeen = new Set();
committees.forEach(function (c) {
  (c.team || []).forEach(function (m) {
    if (ykRe.test(m.role) || coordSeen.has(m.name)) return;
    coordSeen.add(m.name);
    coords.push(m);
  });
});
%>
<% if (leads.length || coords.length) { %>
<section class="tile tile-gray">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <h2>İdari Kurulumuz</h2>
        <p class="section-sub">Proje liderleri ve komite koordinatörlerinden oluşur.</p>
      </div>
      <a class="link-more" href="/komiteler">Komiteleri incele <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></a>
    </div>

    <% if (leads.length) { %>
    <h3 class="people-subhead reveal">Proje Liderleri</h3>
    <div class="people-grid">
      <% leads.forEach(function (m) { %>
      <div class="person reveal">
        <img class="person-photo" src="<%= m.photo %>" alt="<%= m.name %>" loading="lazy">
        <h3><%= m.name %></h3>
        <p><%= m.role %></p>
      </div>
      <% }) %>
    </div>
    <% } %>

    <% if (coords.length) { %>
    <h3 class="people-subhead reveal">Komite Koordinatörleri</h3>
    <div class="people-grid">
      <% coords.forEach(function (m) { %>
      <div class="person reveal">
        <img class="person-photo" src="<%= m.photo %>" alt="<%= m.name %>" loading="lazy">
        <h3><%= m.name %></h3>
        <p><%= m.role %></p>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>
<% } %>

<section class="tile tile-dark join-cta">
  <div class="hero-inner reveal">
    <h2 class="display-light">Bu ekibin içinde<br>senin de yerin var.</h2>
    <div class="cta-row">
      <a class="btn btn-primary" href="/katil">Aramıza katıl</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
