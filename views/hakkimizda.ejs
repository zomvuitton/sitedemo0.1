<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="tile tile-white page-hero">
  <div class="container">
    <div class="page-hero-inner reveal">
      <p class="eyebrow eyebrow-red">Hakkımızda</p>
      <h1><%- br(texts.aboutTitle) %></h1>
      <p class="lede lede-dark"><%= site.description %></p>
    </div>
  </div>
</section>

<!-- Zaman çizelgesi: sol rayda kaydırmayla uzayan ışık; başlıklar kendi
     metinleri geçerken yapışık kalır. Bu üç blokta .reveal yok — giriş
     animasyonunu ray devralıyor. -->
<section class="tile tile-white timeline" data-timeline>
  <div class="container">
    <div class="timeline-items">
      <div class="timeline-track" aria-hidden="true">
        <div class="timeline-beam"></div>
      </div>

      <div class="timeline-item">
        <div class="timeline-marker">
          <span class="timeline-dot" aria-hidden="true"></span>
          <h2>Biz kimiz?</h2>
        </div>
        <div class="timeline-content">
          <p class="lede-dark"><%= site.about[0] %></p>
          <p><%= site.about[1] %></p>
          <img class="aside-img" src="<%= site.aboutImage %>" alt="ODTÜ Verimlilik Topluluğu üyeleri bir arada" loading="lazy">
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-marker">
          <span class="timeline-dot" aria-hidden="true"></span>
          <h2>Vizyonumuz</h2>
        </div>
        <div class="timeline-content">
          <p class="lede-dark"><%= site.vision %></p>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-marker">
          <span class="timeline-dot" aria-hidden="true"></span>
          <h2>Misyonumuz</h2>
        </div>
        <div class="timeline-content">
          <p class="lede-dark"><%= site.mission %></p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="tile tile-dark quote-tile">
  <div class="hero-inner reveal">
    <p class="quote">"<%= texts.aboutQuote %>"</p>
    <p class="quote-source"><%= texts.aboutQuoteSource %></p>
  </div>
</section>

<section class="tile tile-white stats">
  <div class="container stats-grid">
    <div class="stats-head reveal">
      <h2><%= texts.aboutStatsTitle %></h2>
      <p><%= texts.aboutStatsLede %></p>
    </div>
    <dl class="stats-list reveal">
      <% site.stats.forEach(function (s) { %>
      <div class="stat">
        <dt><%= s.label %></dt>
        <dd><%= s.value %></dd>
      </div>
      <% }) %>
    </dl>
  </div>
</section>

<section class="tile tile-gray partners">
  <div class="container">
    <div class="section-head reveal">
      <h2>Partner şirketlerimiz</h2>
      <p class="section-sub"><%= texts.aboutPartnersSub %></p>
    </div>
    <%- include('partials/partner-ticker') %>
  </div>
</section>

<%- include('partials/footer') %>
