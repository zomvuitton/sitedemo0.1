<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="tile tile-white page-hero">
  <div class="container">
    <div class="page-hero-inner reveal">
      <p class="eyebrow eyebrow-red">Komiteler</p>
      <h1>Topluluğun motor dairesi.</h1>
      <p class="lede lede-dark">Tasarımdan sosyal medyaya, veri analizinden kampüs içi etkinliklere — topluluğun tüm işleyişini komiteler sırtlar.</p>
    </div>
  </div>
</section>

<section class="tile tile-gray">
  <div class="container">
    <div class="card-row card-row-2">
      <% committees.forEach(function (c) { %>
      <a class="card card-committee reveal" href="/komiteler/<%= c.slug %>">
        <span class="card-icon"><%- include('partials/icon', { name: c.icon }) %></span>
        <h2><%= c.name %></h2>
        <p><%= c.summary %></p>
        <span class="card-more">Sayfayı incele <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="tile tile-dark join-cta">
  <div class="hero-inner reveal">
    <h2 class="display-light">Hangi komite sana göre?</h2>
    <p class="lede">Komiteleri en iyi kampüste, etkinliklerimizde ve topluluk odamızda tanırsın.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/iletisim">İletişime geç</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
