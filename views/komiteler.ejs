<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="tile tile-white page-hero grid-reveal-hero">
  <!-- Kayan ızgara: sağ alta doğru sürekli akar, yalnız imlecin altı aydınlanır -->
  <div class="grid-reveal" aria-hidden="true"></div>
  <div class="container">
    <div class="page-hero-inner reveal">
      <p class="eyebrow eyebrow-red">Komiteler</p>
      <h1><%- br(texts.committeesTitle) %></h1>
      <p class="lede lede-dark"><%= texts.committeesLede %></p>
    </div>
  </div>
</section>

<section class="tile tile-gray">
  <div class="container">
    <div class="card-row card-row-2">
      <% committees.forEach(function (c) { %>
      <a class="card card-committee reveal" href="/komiteler/<%= c.slug %>">
        <span class="card-icon"><%- include('partials/icon', { name: c.icon }) %></span>
        <h2><%= c.name %></h2>
        <p><%= c.summary %></p>
        <span class="card-more">Sayfayı incele <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="tile tile-dark join-cta">
  <div class="hero-inner reveal">
    <h2 class="display-light"><%- br(texts.committeesCtaTitle) %></h2>
    <p class="lede"><%= texts.committeesCtaLede %></p>
    <div class="cta-row">
      <a class="btn btn-primary" href="/iletisim"><%= texts.campusButton %></a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
