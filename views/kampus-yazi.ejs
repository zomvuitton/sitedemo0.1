<%- include('partials/head') %>
<%- include('partials/nav') %>

<section class="tile tile-white post-hero">
  <div class="container">
    <div class="post-hero-inner reveal">
      <p class="post-meta"><%= trTarih(post.date) %><%= post.tag ? " · " + post.tag : "" %></p>
      <h1><%= post.title %></h1>
      <% if (post.excerpt) { %>
      <p class="lede lede-dark"><%= post.excerpt %></p>
      <% } %>
      <% if (post.author) { %>
      <p class="post-byline"><%= post.author %></p>
      <% } %>
      <div class="cta-row">
        <a class="link-more" href="/kampus">Tüm yazılar <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></a>
      </div>
    </div>
    <% if (post.cover) { %>
    <img class="feature-img" src="<%= post.cover %>" alt="<%= post.title %> yazısının kapak görseli">
    <% } %>
  </div>
</section>

<section class="tile tile-white article-tile">
  <div class="container">
    <div class="article-body reveal">
      <%# Gövde blok listesidir: string = paragraf, nesneler tipli blok (bkz. server.js cleanBlocks) %>
      <% post.body.forEach(function (blok, i) {
           if (typeof blok === "string") blok = { type: "p", text: blok };
           if (blok.type === "p") { %>
      <p class="<%= i === 0 ? 'lede-dark' : '' %>"><%- br(blok.text) %></p>
      <%   } else if (blok.type === "h2") { %>
      <h2><%= blok.text %></h2>
      <%   } else if (blok.type === "quote") { %>
      <blockquote>
        <p><%- br(blok.text) %></p>
        <% if (blok.cite) { %><cite><%= blok.cite %></cite><% } %>
      </blockquote>
      <%   } else if (blok.type === "list" && blok.ordered) { %>
      <ol><% blok.items.forEach(function (madde) { %><li><%= madde %></li><% }) %></ol>
      <%   } else if (blok.type === "list") { %>
      <ul><% blok.items.forEach(function (madde) { %><li><%= madde %></li><% }) %></ul>
      <%   } else if (blok.type === "img") { %>
      <figure>
        <img src="<%= blok.src %>" alt="<%= blok.caption || (post.title + ' yazısından görsel') %>" loading="lazy">
        <% if (blok.caption) { %><figcaption><%= blok.caption %></figcaption><% } %>
      </figure>
      <%   } %>
      <% }) %>
    </div>
  </div>
</section>

<% if (post.gallery && post.gallery.length) { %>
<section class="tile tile-gray gallery-tile">
  <div class="container">
    <div class="section-head reveal">
      <h2>Galeri</h2>
    </div>
    <div class="gallery-grid reveal">
      <% post.gallery.forEach(function (g, i) { %>
      <img src="<%= g %>" alt="<%= post.title %> yazısından <%= i + 1 %>. kare" loading="lazy">
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (digerleri.length) { %>
<section class="tile tile-gray others">
  <div class="container">
    <div class="section-head reveal">
      <h2>Diğer yazılar</h2>
      <a class="link-more" href="/kampus">Tümünü gör <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></a>
    </div>
    <div class="card-row card-row-2">
      <% digerleri.forEach(function (p) { %>
      <a class="card card-post reveal" href="/kampus/<%= p.slug %>">
        <% if (p.cover) { %>
        <img class="card-img" src="<%= p.cover %>" alt="<%= p.title %> yazısının kapak görseli" loading="lazy">
        <% } %>
        <span class="post-meta"><%= trTarih(p.date) %><%= p.tag ? " · " + p.tag : "" %></span>
        <h3><%= p.title %></h3>
        <p><%= p.excerpt %></p>
        <span class="card-more">Okumaya devam <%- include('partials/icon', { name: 'chevron', cls: 'icon-inline' }) %></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
